{{- if and (eq .platform "linux") (not .headless) -}}
#!/usr/bin/env bash
set -euo pipefail

# Re-run fc-cache when the pinned font archive changes.
# fonts.yaml {{ include ".chezmoidata/fonts.yaml" | sha256sum }}
fonts_dir="${XDG_DATA_HOME:-${HOME}/.local/share}/fonts"
if fc_cache="$(command -v fc-cache)"; then
  "${fc_cache}" -- "${fonts_dir}"
fi
{{- /* newline: a break after end would also be emitted when this renders empty */ -}}
{{- println -}}
{{- end -}}
