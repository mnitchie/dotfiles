#!/usr/bin/env bash
set -euo pipefail
{{ if or (eq .platform "linux") (eq .platform "wsl") -}}
{{/* Fedora uses dnf. Debian-family (ID debian or ubuntu, or ID_LIKE containing debian) uses apt. */}}
{{- $id := .chezmoi.osRelease.id -}}
{{- $like := "" -}}
{{- if hasKey .chezmoi.osRelease "idLike" -}}
{{-   $like = .chezmoi.osRelease.idLike -}}
{{- end }}
{{   if eq $id "fedora" -}}
# https://docs.brew.sh/Homebrew-on-Linux
sudo /usr/bin/dnf group install -y{{- range .dnfGroups }} {{ . | quote }}{{ end }}
dnf_packages=(
{{- range .dnf }}
  {{ . | quote }}
{{- end }}
{{- if and (eq .platform "linux") (not .headless) }}
{{- range .dnfLinuxDesktop }}
  {{ . | quote }}
{{- end }}
{{- end }}
)
sudo /usr/bin/dnf install -y "${dnf_packages[@]}"
{{   else if or (eq $id "debian") (eq $id "ubuntu") ($like | contains "debian") -}}
apt_packages=(
{{- range .apt }}
  {{ . | quote }}
{{- end }}
{{- if and (eq .platform "linux") (not .headless) }}
{{- range .aptLinuxDesktop }}
  {{ . | quote }}
{{- end }}
{{- end }}
)
sudo DEBIAN_FRONTEND=noninteractive /usr/bin/apt-get update
sudo DEBIAN_FRONTEND=noninteractive /usr/bin/apt-get install -y "${apt_packages[@]}"
{{   else -}}
{{-     fail (printf "unsupported Linux distribution %q" $id) -}}
{{   end }}
{{ end }}
if [[ ! -x "{{ .brewPrefix }}/bin/brew" ]]; then
  # bash -c "$(curl ...)" exits 0 when curl fails, and chezmoi would record this run_once script as done.
  installer="$(/usr/bin/mktemp)"
  trap '/bin/rm -f "$installer"' EXIT
  /usr/bin/curl -fsSL -o "${installer}" https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh
  # With NONINTERACTIVE set, install.sh uses `sudo -n` and aborts with
  # "Insufficient permissions" instead of prompting. Skip it when sudo needs a password.
  if /usr/bin/sudo -n true 2>/dev/null; then
    NONINTERACTIVE=1 /bin/bash "${installer}"
  else
    /bin/bash "${installer}"
  fi
fi
