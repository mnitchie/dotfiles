{{ if eq .packageManager "macports" -}}
#!/usr/bin/env bash
set -euo pipefail

# MacPorts needs Command Line Tools even for binary archives. Like Homebrew's
# installer, find them through softwareupdate instead of the xcode-select GUI.
if ! /usr/bin/xcode-select -p >/dev/null 2>&1; then
  placeholder=/tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
  /usr/bin/touch "${placeholder}"
  label="$(/usr/sbin/softwareupdate -l 2>/dev/null \
    | /usr/bin/sed -n 's/^[[:space:]]*\* Label: \(Command Line Tools.*\)$/\1/p' \
    | /usr/bin/sort -V | /usr/bin/tail -n 1)"
  /bin/rm -f "${placeholder}"
  if [[ -z "${label}" ]]; then
    /usr/bin/xcode-select --install || true
    printf 'Finish installing Command Line Tools, then run chezmoi apply again\n' >&2
    exit 1
  fi
  sudo /usr/sbin/softwareupdate -i "${label}"
  sudo /usr/bin/xcode-select --switch /Library/Developer/CommandLineTools
fi

if [[ ! -x "{{ .packagePrefix }}/bin/port" ]]; then
  os_major="$(/usr/bin/sw_vers -productVersion | /usr/bin/cut -d. -f1)"
  case "${os_major}" in
{{- range $major, $installer := .macports.installers }}
    {{ $major }}) pkg_name="MacPorts-{{ $.macports.version }}-{{ $major }}-{{ $installer.name }}.pkg"; pkg_sha256="{{ $installer.sha256 }}" ;;
{{- end }}
    *)
      printf 'No pinned MacPorts installer for macOS %s; add it to .chezmoidata/macports.yaml\n' "${os_major}" >&2
      exit 1
      ;;
  esac
  pkg_dir="$(/usr/bin/mktemp -d)"
  trap '/bin/rm -rf "${pkg_dir}"' EXIT
  /usr/bin/curl -fsSL -o "${pkg_dir}/${pkg_name}" \
    "https://github.com/macports/macports-base/releases/download/v{{ .macports.version }}/${pkg_name}"
  printf '%s  %s\n' "${pkg_sha256}" "${pkg_dir}/${pkg_name}" | /usr/bin/shasum -a 256 -c -
  sudo /usr/sbin/installer -pkg "${pkg_dir}/${pkg_name}" -target /
fi
{{ end -}}
