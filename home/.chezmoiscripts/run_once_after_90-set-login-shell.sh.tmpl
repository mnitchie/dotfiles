{{- if or (eq .platform "linux") (eq .platform "wsl") -}}
#!/usr/bin/env bash
set -euo pipefail

# chsh only accepts shells listed in /etc/shells. Homebrew's zsh is not; apt's is.
user="$(/usr/bin/id -un)"
passwd_entry="$(/usr/bin/getent passwd "${user}")"
login_shell="${passwd_entry##*:}"
if [[ "${login_shell}" != "/usr/bin/zsh" ]]; then
  sudo /usr/bin/chsh -s /usr/bin/zsh "${user}"
fi
{{- /* newline: a break after end would also be emitted when this renders empty */ -}}
{{- println -}}
{{- end -}}
