[".agents/skills/gh-stack"]
type = "archive"
url = "https://github.com/github/gh-stack/archive/refs/tags/v0.1.0.tar.gz"
exact = true
stripComponents = 3
include = ["*/skills/gh-stack/**"]
checksum.sha256 = "cf510d30c78453cce0b833d8c04db09a1ae8b6d8770f1163b58b0554e9d3e0fd"
{{ if and (eq .platform "linux") (not .headless) -}}
[".local/share/fonts/JetBrainsMonoNerdFont"]
type = "archive"
url = {{ .jetbrainsMonoNerdFont.url | quote }}
exact = true
include = ["*.ttf", "LICENSE*", "LICENSE", "OFL.txt"]
checksum.sha256 = {{ .jetbrainsMonoNerdFont.sha256 | quote }}
{{- end -}}
