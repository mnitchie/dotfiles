{{- if eq .platform "darwin" -}}
if status is-interactive
    # Apple Silicon does not expose the SMC temperature sampler.
    if command -q powermetrics; and powermetrics --help 2>&1 | string match -rq '^\s+smc\s'
        alias temp 'sudo powermetrics --samplers smc | command grep -E -i "temp|fan"'
    end
end
{{ end -}}
