{{- if and .work .opWorkAccount -}}
{{-   $token := onepasswordRead "op://Private/Gemfury/credential" .opWorkAccount -}}
{{-   $org := onepasswordRead "op://Private/Gemfury/org" .opWorkAccount -}}
{{-   $pipExtraIndexUrl := printf "https://%s:@pypi.fury.io/%s/" $token $org -}}
{{-   $cfToken := onepasswordRead "op://Private/Cloudflare/credential" .opWorkAccount -}}
{{-   $stitchKey := onepasswordRead "op://Private/Google Stitch/credential" .opWorkAccount -}}
# Generated by chezmoi from 1Password; edit the items in the work account's Private vault (Gemfury, Cloudflare, Google Stitch), then `chezmoi apply`.
export FURY_AUTH={{ $token | shellQuote }}
export UV_INDEX_GEMFURY_USERNAME={{ $token | shellQuote }}
export UV_INDEX_GEMFURY_PASSWORD='NOPASS'
export PIP_EXTRA_INDEX_URL={{ $pipExtraIndexUrl | shellQuote }}
export CLOUDFLARE_API_TOKEN={{ $cfToken | shellQuote }}
export GOOGLE_STITCH_API_KEY={{ $stitchKey | shellQuote }}
{{ end -}}
