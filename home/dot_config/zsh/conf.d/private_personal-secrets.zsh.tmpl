{{- if .opPersonalAccount -}}
{{-   $cloudflare := onepasswordRead "op://Private/Cloudflare/credential" .opPersonalAccount -}}
{{-   $stitch := onepasswordRead "op://Private/Google Stitch/credential" .opPersonalAccount -}}
# Generated by chezmoi from 1Password; edit the 1Password items Private/Cloudflare and Private/Google Stitch, then `chezmoi apply`.
export CLOUDFLARE_API_TOKEN={{ $cloudflare | shellQuote }}
export GOOGLE_STITCH_API_KEY={{ $stitch | shellQuote }}
{{ end -}}
