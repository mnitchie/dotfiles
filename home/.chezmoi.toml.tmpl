{{- $platform := "" -}}
{{- $packageManager := "homebrew" -}}
{{- $packagePrefix := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $platform = "darwin" -}}
{{-   if eq .chezmoi.arch "arm64" -}}
{{-     $packagePrefix = "/opt/homebrew" -}}
{{-   else if eq .chezmoi.arch "amd64" -}}
{{/* Homebrew builds no Intel bottles and stops running on Intel Macs in September 2027. */}}
{{-     $packageManager = "macports" -}}
{{-     $packagePrefix = "/opt/local" -}}
{{-   else -}}
{{-     fail (printf "unsupported Mac architecture %q" .chezmoi.arch) -}}
{{-   end -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   $platform = "linux" -}}
{{-   $packagePrefix = "/home/linuxbrew/.linuxbrew" -}}
{{/* .chezmoi.kernel is Linux-only and may be absent on darwin. */}}
{{-   if hasKey .chezmoi "kernel" -}}
{{-     if hasKey .chezmoi.kernel "osrelease" -}}
{{-       if .chezmoi.kernel.osrelease | lower | contains "microsoft" -}}
{{-         $platform = "wsl" -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- else -}}
{{-   fail (printf "unsupported operating system %q" .chezmoi.os) -}}
{{- end -}}
{{- $work := promptBoolOnce . "work" "Work machine" -}}
{{- $workEmail := "" -}}
{{- $opWorkAccount := "" -}}
{{- if $work -}}
{{-   $workEmail = promptStringOnce . "workEmail" "Work email" -}}
{{-   $opWorkAccount = promptStringOnce . "opWorkAccount" "Work 1Password account sign-in address (blank to skip work secrets)" -}}
{{- end -}}
{{- $headless := false -}}
{{- if eq $platform "linux" -}}
{{-   $headless = promptBoolOnce . "headless" "Headless Linux (no 1Password app)" -}}
{{- end -}}
{{- $windowsUser := "" -}}
{{- if eq $platform "wsl" -}}
{{-   $windowsUser = promptStringOnce . "windowsUser" "Windows user folder name" -}}
{{- end -}}
[data]
platform = {{ $platform | quote }}
packageManager = {{ $packageManager | quote }}
packagePrefix = {{ $packagePrefix | quote }}
headless = {{ $headless }}
work = {{ $work }}
workEmail = {{ $workEmail | quote }}
opWorkAccount = {{ $opWorkAccount | quote }}
windowsUser = {{ $windowsUser | quote }}
{{- if eq $platform "darwin" }}

[onepassword]
command = {{ printf "%s/bin/op" $packagePrefix | quote }}
{{- else if eq $platform "wsl" }}

[onepassword]
command = "op.exe"
{{- end }}
